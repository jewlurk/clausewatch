# Copy to .env for local dev. .env is gitignored.
# Public config (safe to share) — the real values for this project are below as defaults.
SUPABASE_URL=https://psppoaswytqhkdqbudnv.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_4xJeF_hTegqxacOVWATsgQ__y2xEemb

# SECRETS — never commit real values. Set these in GitHub Actions / Cloudflare secrets.
# Get from Supabase → Settings → API Keys (secret) and Settings → Database (connection string).
SUPABASE_SECRET_KEY=sb_secret_xxx_set_in_github_secrets
# Use the SESSION POOLER string, not the direct connection: Supabase direct
# connections are IPv6-only on the free tier and GitHub Actions runners are IPv4.
DATABASE_URL=postgresql://postgres.psppoaswytqhkdqbudnv:[YOUR-DB-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Cloudflare R2 (private bucket) — set later, secrets only.
R2_ACCOUNT_ID=453137188783dc5aaf71b39099f195ba
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clausewatch-raw

# Crawler identity (brief §4.4 — descriptive UA with contact email, mandatory).
CRAWLER_USER_AGENT=clausewatch/0.1 (+https://github.com/jewlurk/clausewatch; contact: hs20.26@ichat.sp.edu.sg)
CRAWLER_MIN_INTERVAL_SECONDS=2

# LLM (Phase 5, T28) — leave blank until then.
GEMINI_API_KEY=
LLM_MONTHLY_TOKEN_CEILING=2000000

# Alert email (T26). Resend free tier: 100/day, 3,000/month, 3 domains
# (verified 26 Aug 2026). Resend requires a VERIFIED SENDING DOMAIN — there is no
# domainless send path — so ALERT_FROM must be at a domain added in the Resend
# dashboard. Set RESEND_API_KEY as a GitHub secret and ALERT_FROM as a repo variable.
RESEND_API_KEY=
ALERT_FROM=Clausewatch alerts <alerts@yourdomain.sg>
ALERT_DAILY_CAP=90

# Cost report (T29). Weekly health/cost email; degrades to a printed report when unset.
# FOUNDER_EMAIL is a GitHub repo variable, ALERT_FROM/RESEND_API_KEY as for T26.
FOUNDER_EMAIL=you@yourdomain.sg
